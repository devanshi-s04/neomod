# Paper directory (Overleaf-linked)
/paper/

# Large data outputs
*.npz
*.parquet

# Figure outputs
*.png
*.pdf

# Exception: the score-regime proof notebook's figures are durable deliverables required by the
# staging list in docs/gorica_24_aug_ legacy_vs_new.md. Without this negation the *.png rule above
# would exclude them and they could only be added with --force.
!outputs/neomod3_new_vs_legacy_score_regime/figures/*.png

# Python cache
__pycache__/
*.pyc
*.pyo

# Jupyter / matplotlib cache
.ipynb_checkpoints/
.matplotlib-cache/

# Logs and lock files
*.log
*.lock

# S3M data files (large raw input)
S3Mdata/

# Misc generated files
*.html
*.aux
*.fdb_latexmk
*.fls
*.out
*.synctex.gz

# NEOMOD3 input data (62 MB, re-downloadable from Boulder SWRI)
NEOMOD3/

# Pipeline data inputs (large, Hyak-only)
pipeline/CDS_colors.parquet
neocp_data/
